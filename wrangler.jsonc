{
  "name": "rmpix",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "DIRECTORY",
        "class_name": "Directory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Directory"
      ]
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}